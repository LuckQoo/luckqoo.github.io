# 後端環境設定（填好後可複製為 .env）
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=你的模型名
CORS_ORIGIN=https://epoch-shop.shop
# SERPAPI_KEY=你的_serpapi_key  # 沒有可留空，網搜尋功能會自動跳過

# 帳號登入用的簽章密鑰，隨便一長串亂數字串即可（例如用 openssl rand -hex 32 產生）
JWT_SECRET=

# 網站對外網址，Stripe 結帳完成後會導回這裡
APP_URL=https://epoch-shop.shop

# Stripe 金鑰：到 https://dashboard.stripe.com/apikeys 拿
STRIPE_SECRET_KEY=
# 公開金鑰（pk_live_/pk_test_ 開頭），前端 Payment Element 用來初始化 Stripe.js
STRIPE_PUBLISHABLE_KEY=
# Webhook 簽章密鑰：建立 webhook endpoint（見部署說明）後 Stripe 會給
# 需訂閱的事件：customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=

# 測試金鑰（給你自己私下測試用，不影響正式客人）
STRIPE_SECRET_KEY_TEST=
STRIPE_PUBLISHABLE_KEY_TEST=
# 只有知道這組密碼的人，加上 ?dev=這組密碼 才會切到測試模式（用 openssl rand -hex 16 產生一組）
DEV_MODE_TOKEN=

# Codapay Publisher Portal 提供的 API key，僅供後端驗證通知 checksum。
CODAPAY_API_KEY=
CODAPAY_PROJECT_ID=3912
CODAPAY_ENV=sandbox

# Shared HMAC-SHA256 key entered in the Codashop Fulfilment API settings.
# Generate a unique random value of 64 characters or fewer; never commit the real key.
CODASHOP_SECRET_KEY=
